{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "daemons": {
    "worker": {
      "root": "./",
      "entrypoint": "Dockerfile",
      "instances": {
        "fra1": 1
      },
      "terminationGracePeriodSeconds": 300
    }
  }
}
